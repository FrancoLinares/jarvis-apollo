# Configuración local del operador (tu Mac). Copiala a jarvis.env y completala.
# jarvis.env está en el .gitignore. NO van secretos acá: esos van al Llavero
# (scripts/secrets.sh). Esto es solo dónde está cada cosa.

# Usuario y IP de la Raspberry Pi (reservá la IP en el router: si cambia, la
# placa deja de conectar y hay que recompilar el firmware).
JARVIS_PI=pi@192.168.0.50

# URL base del servidor tal como la ve la placa (sin path).
JARVIS_APOLLO_URL=ws://192.168.0.50:8799

# Nombre del dispositivo. Tiene que coincidir con APOLLO_DEVICE_NAME en server/config.env.
JARVIS_DEVICE_NAME=jarvis

# Para tools/desk-simulator.ts
JARVIS_APOLLO_HOST=192.168.0.50:8799

# Servicio del Llavero donde viven los secretos (cuenta = nombre de la variable).
# JARVIS_KEYCHAIN_SERVICE=jarvis

# Carpetas en la Pi, relativas al home del usuario (defaults).
# JARVIS_PI_APOLLO_DIR=apollo-server
# JARVIS_PI_MCP_DIR=mcp-servers
# JARVIS_PI_WHATSAPP_DIR=whatsapp
