CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# -O2: the LVGL/emote/TFLM hot paths are compiled code, and the app slot
# has more than a megabyte of slack to trade for speed.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_USE_MICRO_WAKE_WORD=y
# The current "Hey, Apólo" model evaluates at ~68% recall; 50 is its usable
# operating point. Raise toward 90 when a stronger model lands.
# El manifiesto de hey_jarvis declara probability_cutoff 0.97.
CONFIG_MICRO_WAKE_WORD_PROBABILITY_CUTOFF=80

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

CONFIG_APOLLO_PROTOCOL=y

# Jarvis 2026-09-30: búferes TCP para audio sobre el WiFi del repetidor (5760 B
# daban ~29 KB/s a 200 ms de RTT; el audio necesita 32 KB/s de subida y 48 de
# bajada) y lwIP en PSRAM porque la RAM interna está justa.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Volcado de memoria en flash ante un cuelgue: al próximo arranque se manda el
# resumen al servidor (boot_report). Partición "coredump" en partitions/v2/16m.csv.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
