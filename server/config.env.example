# Parte NO secreta del .dev.vars de Apollo. Copiala a server/config.env (está en
# el .gitignore) y ajustala. scripts/push-secrets.sh apollo junta esto con los
# secretos del Llavero y lo sube a la Pi. Si ponés acá un nombre que figura en
# secrets.manifest, el script se niega a subirlo.
#
# Valores probados en producción (octubre 2026).

# --- Dispositivo
APOLLO_DEVICE_NAME=jarvis

# --- Modelos (todo por OpenRouter: una sola key)
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Voz: piper (local, gratis, acento mexicano) | azure (es-AR, 4x más rápido) | elevenlabs
TTS_PROVIDER=azure
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_VOICE=es-AR-TomasNeural
# Piper queda siempre de red de seguridad: si Azure falla o falta la key, habla Piper.
PIPER_BINARY=/piper/piper/piper
PIPER_LIBRARY_DIR=/piper/piper
PIPER_VOICE_MODEL=/piper/voices/es_MX-ald-medium.onnx

# --- Conversación
# on: el micrófono se reabre después de cada respuesta (se cierra solo a los ~3 s de silencio)
CONVERSATION_MODE=on
# Router de intenciones con Jev: on | shadow (decide y anota, usa todas las herramientas) | off
ROUTER_MODE=on
# A/B del razonamiento: en este % de los turnos se invierte la decisión de Jev para aprender
ROUTER_REASONING_EXPLORE=0.2
# Personajes por tono (sarcástico, relator, mayordomo): on | off
PERSONAJES=on

# --- Parlante externo por el jack de la Pi (infra/speaker). Sin SPEAKER_TOKEN no se usa.
SPEAKER_URL=http://host.docker.internal:8790
SPEAKER_ROUTE=avisos

# --- Avisos opcionales (apagados por defecto; prendelos con =on)
# Partidos de tu equipo (nombre como lo escribe ESPN, Liga Profesional argentina)
# FOOTBALL_TEAM=Racing Club
# Torneos nuevos de Premier Padel (scraping de padelfip.com)
# EVENT_WATCHES=on
# Vencimientos leídos de Gmail: se activa solo al cargar GMAIL_USER y GMAIL_APP_PASSWORD
# en el Llavero. Conceptos que ya tienen recordatorio fijo, para no duplicarlos:
# BILLING_SKIP_CONCEPTS=alquiler,expensas

# --- Avisos que vienen prendidos (apagalos con =off)
# DEPARTURE_ALERTS=off      # "a qué hora salir" (necesita GOOGLE_MAPS_API_KEY)
# REMINDER_ALARM=off        # alarma sonora + pantalla completa en los recordatorios

# --- WhatsApp (WAHA en la misma Pi). La key y los números van al Llavero.
WAHA_URL=http://waha:3000
WAHA_SESSION=default

# Para probar el flujo sin ninguna API key (respuestas simuladas):
# MOCK_VOICE=1
